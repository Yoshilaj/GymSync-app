# Supabase project (Project Settings → API).
# URL is the same one the frontend uses.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service role key — SECRET, backend only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Anon (publishable) key — same value the Expo app uses. Powers the public
# auth endpoints (signup/login/reset); safe to expose, unlike the service key.
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# JWT secret (Project Settings → API → JWT Settings).
SUPABASE_JWT_SECRET=YOUR-JWT-SECRET

# Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Voice pipeline keys.
DEEPGRAM_API_KEY=YOUR-DEEPGRAM-KEY
ELEVENLABS_API_KEY=YOUR-ELEVENLABS-KEY

# ── Apple In-App Purchase ────────────────────────────────────────────────────
# Must match app.json ios.bundleIdentifier exactly.
APPLE_BUNDLE_ID=com.yoshinishikawahara.gymsync

# Which environments a transaction may be verified against, tried in order.
# This is a SECURITY setting, not a preference: Apple's library skips signature
# verification entirely for "Xcode"/"LocalTesting", so this list must never be
# derived from the incoming transaction. See app/billing/apple.py.
#   local simulator testing : Xcode
#   TestFlight              : Sandbox
#   App Store               : Production,Sandbox
APPLE_ENVIRONMENTS=Xcode

# Required to accept Xcode/LocalTesting transactions, which are signed by a
# local test certificate and CANNOT be verified. The server refuses to start if
# this is true while APP_ENV=production.
APPLE_ALLOW_LOCAL_TESTING=true

# The app's numeric App Store ID. Unknown until the App Store Connect record
# exists — and Apple's verifier cannot construct a Production verifier without
# it, which is what correctly keeps Production unreachable until then.
APPLE_APP_ID=0

# "development" | "production". Gates the checks above.
APP_ENV=development

# Crash reporting (Sentry → Project Settings → Client Keys). Leave empty and the
# SDK is never initialised, which is what you want locally.
SENTRY_DSN=

# ── Voice ────────────────────────────────────────────────────────────────────
# Which TTS provider speaks the coach's replies. Deepgram Aura is the default and
# is what the privacy policy discloses as the primary voice processor; changing
# it means changing that disclosure too.
TTS_PROVIDER=aura
# Tried only when the primary fails. Empty = no fallback (a TTS outage becomes a
# silent coach rather than a slower one).
TTS_FALLBACK_PROVIDER=

# ── RAG serving ──────────────────────────────────────────────────────────────
# The defaults in config.py are the no-download stubs, which return meaningless
# embeddings — fine for tests, useless in production. Production MUST set these,
# and must match how the corpus was ingested (nomic 768-d, v2) or retrieval
# silently returns nonsense rather than failing.
#
# These two model names are also baked into the Docker image at build time; if
# you change them here, change the Dockerfile or the first premium search
# downloads several hundred megabytes at runtime.
EMBEDDER=nomic
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
RERANKER=cross_encoder
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
KNOWLEDGE_CORPUS_VERSION=v2
CACHE_TTL_S=300
KNOWLEDGE_CACHE_TTL_S=86400

# ── Networking (production) ──────────────────────────────────────────────────
# Comma-separated browser origins. Empty is correct for a native-only app: a
# React Native fetch sends no Origin header, so an empty list costs nothing and
# keeps every website out.
CORS_ORIGINS=

# Turn ON only behind a proxy you control (Fly, Cloudflare, nginx). It makes the
# rate limiter trust the last X-Forwarded-For hop. Left off behind a proxy, every
# caller shares one bucket; turned on WITHOUT a proxy, anyone can forge the
# header and mint themselves a fresh budget per request.
TRUSTED_PROXY=false

# ── Not implemented ──────────────────────────────────────────────────────────
# Shared rate-limit/cache store. RedisCache in app/cache.py is still a stub, so
# the server deliberately REFUSES TO START if this is set — setting it would
# otherwise imply limits are shared across processes when they aren't. Leave
# empty until RedisCache is real.
REDIS_URL=
