{
  "expo": {
    "name": "GymSync",
    "slug": "gymsync",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gymsync",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#2E90EA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yoshinishikawahara.gymsync",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "GymSync uses your microphone so you can talk to your AI coach during a workout.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.gymsync.app",
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "GymSync uses your microphone so you can talk to your AI coach during a workout."
        }
      ],
      "expo-asset",
      "onnxruntime-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "GymSync uses your photos so you can set a profile picture.",
          "cameraPermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "GymSync uses your microphone so you can dictate messages and talk to your AI coach.",
          "speechRecognitionPermission": "GymSync uses speech recognition to turn your voice into text."
        }
      ],
      "expo-iap",
      "./plugins/withStoreKitConfig",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.543034401462-bq6sekmtuubvc0uqcu57j61ouilg901q"
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native",
        {
          "organization": "gymsync-7s",
          "project": "gymsync-app"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a8e353d2-40bd-41ff-8f1d-5ceca2cdd155"
      }
    },
    "owner": "gymsync.app"
  }
}
