{
  "expo": {
    "name": "GymSync",
    "slug": "gymsync",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gymsync",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymsync.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "GymSync uses your microphone so you can talk to your AI coach during a workout."
      }
    },
    "android": {
      "package": "com.gymsync.app",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "GymSync uses your microphone so you can talk to your AI coach during a workout."
        }
      ]
    ]
  }
}
