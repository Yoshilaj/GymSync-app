# Base URL of the GymSync backend (FastAPI).
# Simulator can use localhost; a physical device needs your machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase project (Project Settings → API).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Google sign-in (Google Cloud Console → Credentials). BOTH are required, and
# they are not interchangeable: the native sheet uses the iOS client, while
# Supabase validates the returned token's audience against the WEB client.
# Leave them unset and the Google button simply isn't rendered.
# See docs/AUTH_SETUP.md.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Crash reporting (Sentry → Project Settings → Client Keys). Safe to ship in the
# bundle — a DSN only accepts events, it can't read them. Leave it unset and
# reporting is simply off; it's also off in development regardless.
EXPO_PUBLIC_SENTRY_DSN=
